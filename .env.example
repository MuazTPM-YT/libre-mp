# Copy to .env and fill in. .env is gitignored.

# Optional: real projector QR payloads for core/tests/qr_parse.rs.
# Raw QR bytes as hex (still XOR-obfuscated), plus the Wi-Fi password and SSID they hold.
# Tests that need them are skipped when they are empty.
LIBREMP_TEST_QR_WIRED_HEX=
LIBREMP_TEST_QR_WIRED_PASSWORD=
LIBREMP_TEST_QR_WIRED_SSID=
LIBREMP_TEST_QR_WIRELESS_HEX=
LIBREMP_TEST_QR_WIRELESS_PASSWORD=
LIBREMP_TEST_QR_WIRELESS_SSID=
